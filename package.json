{
  "name": "my-deployment-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Science HOD teacher deployment solver (browser-only MILP solver, layered constraints)",
  "scripts": {
    "test": "node --test tests/unit/**/*.test.js",
    "serve": "http-server -p 8080 -c-1",
    "e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-my-deployment-buddy",
    "test:rules": "firebase emulators:exec --project demo-my-deployment-buddy --only firestore,auth \"node --test tests/rules/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.48.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.32.0",
    "highs": "^1.15.3",
    "http-server": "^14.1.1"
  }
}
